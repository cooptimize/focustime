{
  "name": "focustime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node server/main.ts --dev",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "guards": "node scripts/guards.ts",
    "demo:check": "node scripts/demo-check.ts",
    "docs:diagrams": "node scripts/docs-diagrams.ts",
    "docs:check": "vitest run scripts/tech-docs.test.ts",
    "check": "npm run typecheck && npm run guards",
    "test": "vitest run",
    "test:zones": "for z in America/New_York America/Chicago America/Denver America/Los_Angeles; do echo \"TZ=$z\"; TZ=$z vitest run --silent || exit 1; done",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.mjs",
    "start": "vite build && node server/main.ts",
    "serve": "node server/main.ts",
    "db:up": "node scripts/db.ts up",
    "db:migrate": "node scripts/db.ts migrate",
    "db:reset": "node scripts/db.ts reset",
    "db:down": "node scripts/db.ts down",
    "focustime": "node scripts/focustime.ts"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@microsoft/teams.api": "2.1.1",
    "@microsoft/teams.apps": "2.1.1",
    "@microsoft/teams.cards": "2.1.1",
    "ical.js": "2.2.1",
    "mssql": "12.7.13",
    "openid-client": "6.8.9",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "marked": "18.1.1",
    "opentype.js": "1.3.4",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "bin": {
    "focustime": "scripts/focustime.ts"
  },
  "overrides": {
    "@microsoft/teams.apps": {
      "@azure/msal-node": "7.1.2"
    }
  }
}
