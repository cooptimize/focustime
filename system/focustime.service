# FocusTime server as a systemd user service, for the developer loop only (system/README.md). A template: install with
# system/install.sh, which fills in the repo folder and the node it finds.
[Unit]
Description=FocusTime developer server (127.0.0.1:5317)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@REPO@
# Build the UI so the service always serves the current code, then run the server without opening a window.
ExecStartPre=@NODE@ node_modules/vite/bin/vite.js build --logLevel warn
ExecStart=@NODE@ server/main.ts --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
