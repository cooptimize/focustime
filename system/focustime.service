# FocusTime server as a systemd user service (step 5). Install with system/install.sh, which sets WorkingDirectory to
# wherever the repo is.
[Unit]
Description=FocusTime local week planner (127.0.0.1:5317)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/tanner/Code/focustime
# Build the UI so the service always serves the current code, then run the server without opening a window.
ExecStartPre=/home/tanner/.local/share/mise/shims/node node_modules/vite/bin/vite.js build --logLevel warn
ExecStart=/home/tanner/.local/share/mise/shims/node server/main.ts --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
