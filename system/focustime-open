#!/bin/bash
# Open FocusTime, or focus its window if one is already open. One launch path for the launcher,
# the key binding and login autostart.
#
#   focustime-open           start the service if needed, wait for it, then launch or focus the window
#   focustime-open --capture same, then the window opens Quick capture (step 9)
#   focustime-open --window  (used by the step above) launch the app window
#
# The launch link holds the per-launch token. It is read from the server's private file
# ($XDG_RUNTIME_DIR/focustime/launch.json, mode 0600) and handed straight to the browser.
# It is never printed, logged or passed through eval.
#
# Developer loop only (see system/README.md). The window is launched and focused through two optional helpers named
# in ${XDG_CONFIG_HOME:-~/.config}/focustime/launcher.env, one KEY=program line each (read as data, never sourced):
#   FOCUSTIME_WEBAPP=<program>  launches the app window: <program> <url> <browser flags...>
#   FOCUSTIME_FOCUS=<program>   focuses a matching window or runs a launch command: <program> <window pattern> <command>
# Without them: Chromium --app, and a new window each time.
#
# --capture leaves a one-shot request file ($XDG_RUNTIME_DIR/focustime/open-request, mode 0600) holding only the
# word "capture". The window takes it (POST /api/open-request) when it loads or gains focus. No token is involved.
set -euo pipefail

LAUNCH_FILE="${XDG_RUNTIME_DIR:-/tmp}/focustime/launch.json"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/focustime/browser"
# Chromium names an --app window after its host and profile, and ignores --class for it. The
# dedicated data directory always uses profile "Default", so the class is stable: chrome-127.0.0.1__-Default.
WINDOW_PATTERN='^(focustime|chrome-127\.0\.0\.1__-default)$'
WAIT_SECONDS=60
# Which server the open window was launched for. After a service restart the window's token is stale,
# so that window is replaced instead of focused.
WINDOW_FILE="${XDG_RUNTIME_DIR:-/tmp}/focustime/window-server-pid"
LAUNCHER_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/focustime/launcher.env"

# The two helpers: program names or paths only, from a file of ours that only we can write.
WEBAPP=""
FOCUS=""
if [[ -f $LAUNCHER_ENV && -O $LAUNCHER_ENV && ! -L $LAUNCHER_ENV ]] && ! find "$LAUNCHER_ENV" -perm /022 | grep -q .; then
  while IFS='=' read -r key value; do
    [[ $value =~ ^[A-Za-z0-9_./-]+$ ]] || continue
    case $key in
      FOCUSTIME_WEBAPP) WEBAPP=$value ;;
      FOCUSTIME_FOCUS) FOCUS=$value ;;
    esac
  done <"$LAUNCHER_ENV"
fi

fail() {
  echo "focustime-open: $1" >&2
  command -v notify-send >/dev/null && notify-send -a FocusTime -i focustime "FocusTime" "$1" || true
  exit 1
}

# Prints the launch link only into a variable of the caller. Succeeds when the server named in
# the launch file is alive and answers on 127.0.0.1.
read_link() {
  local url pid port code
  [[ -r $LAUNCH_FILE ]] || return 1
  url=$(jq -r '.url // empty' "$LAUNCH_FILE" 2>/dev/null) || return 1
  pid=$(jq -r '.pid // empty' "$LAUNCH_FILE" 2>/dev/null) || return 1
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  [[ $url =~ ^http://127\.0\.0\.1:([0-9]+)/ ]] || return 1
  port=${BASH_REMATCH[1]}
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$port/" 2>/dev/null) || return 1
  ((code > 0 && code < 500)) || return 1
  LINK=$url
  SERVER_PID=$pid
}

wait_for_link() {
  local deadline=$((SECONDS + WAIT_SECONDS))
  until read_link; do
    ((SECONDS < deadline)) || fail "FocusTime did not start. Check: systemctl --user status focustime"
    sleep 1
  done
}

if [[ ${1:-} == "--window" ]]; then
  LINK=""
  wait_for_link
  printf '%s\n' "$SERVER_PID" >"$WINDOW_FILE"
  # A data directory of its own: a stable window class, and the window stays apart from browsing profiles.
  if [[ -n $WEBAPP ]]; then
    exec "$WEBAPP" "$LINK" --user-data-dir="$DATA_DIR" --no-first-run --no-default-browser-check
  fi
  exec chromium --app="$LINK" --user-data-dir="$DATA_DIR" --no-first-run --no-default-browser-check
fi

CAPTURE=0
if [[ ${1:-} == "--capture" ]]; then
  CAPTURE=1
elif [[ -n ${1:-} ]]; then
  fail "Unknown option: $1 (use --capture, or nothing)"
fi

if ! systemctl --user is-active --quiet focustime.service; then
  systemctl --user start focustime.service || fail "Could not start the FocusTime service. Check: systemctl --user status focustime"
fi
LINK=""
wait_for_link
unset LINK

# The request goes in before the window is focused or launched, so its focus or load finds it.
if ((CAPTURE)); then
  REQUEST_DIR=$(dirname "$LAUNCH_FILE")
  (
    umask 077
    tmp=$(mktemp "$REQUEST_DIR/open-request.XXXXXX")
    printf 'capture\n' >"$tmp"
    mv -f "$tmp" "$REQUEST_DIR/open-request"
  ) || fail "Could not ask FocusTime to open Quick capture"
fi

# Window lookup and close need a compositor with hyprctl; elsewhere this step is skipped.
window_address() {
  command -v hyprctl >/dev/null || return 0
  hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1
}

# A window opened for an earlier server run can't talk to this one: close it so a fresh one opens.
address=$(window_address)
if [[ -n $address && $(cat "$WINDOW_FILE" 2>/dev/null) != "$SERVER_PID" ]]; then
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null 2>&1 || hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    [[ -z $(window_address) ]] && break
    sleep 0.25
  done
fi

# Focus the window titled exactly "FocusTime" or with that class, or launch it. (A plain "focustime"
# would also match a terminal titled after the project.) The launch command is a fixed
# string, so nothing from the launch file reaches eval inside the focus helper.
if [[ -n $FOCUS ]]; then
  exec "$FOCUS" "$WINDOW_PATTERN" "$(printf '%q' "$(readlink -f "$0")") --window"
fi
exec "$(readlink -f "$0")" --window
