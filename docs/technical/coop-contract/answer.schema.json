{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.focustime.example/coop-contract/v1/answer.schema.json",
  "title": "Coop answer v1",
  "description": "A person's answer to one numbered question. Posted by the requester as a [Coop answer v1] comment.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "brief_id",
    "revision",
    "question_id",
    "answer"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "coop_answer"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "brief_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "question_id": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]{0,2}$"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    }
  }
}
