{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.focustime.example/coop-contract/v1/update.schema.json",
  "title": "Coop update v1",
  "description": "Where a brief stands. Posted by Coop as a [Coop update v1] comment.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "brief_id",
    "revision",
    "status",
    "summary",
    "proposal_ids",
    "question_ids",
    "occurred_at",
    "posted_at"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "coop_update"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "brief_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "received",
        "working",
        "blocked",
        "done",
        "declined",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]*[^\\s][^\\r\\n]*$"
    },
    "proposal_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,16}$"
      }
    },
    "question_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^Q[1-9][0-9]{0,2}$"
      }
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "posted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[1-9][0-9]{0,2}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "blocking": {
            "type": "boolean"
          },
          "suggested_answers": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "proposals": {
      "$ref": "proposal.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "questions"
        ],
        "properties": {
          "question_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "done"
          }
        }
      },
      "then": {
        "required": [
          "proposals"
        ],
        "properties": {
          "proposal_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
